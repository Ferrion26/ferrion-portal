generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Uncomment directUrl when using Supabase pgbouncer (transaction pooler) as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubscriptionPackage {
  MONITOR
  OPERATE
  COMPLETE
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum ReportPeriodType {
  MONTH
  QUARTER
  HALF_YEAR
  YEAR
}

enum IngestionSource {
  COLLECTOR
  MANUAL_UPLOAD
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  company      String?
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders                      Order[]
  quotes                      Quote[]
  documents                   Document[]
  tickets                     SupportTicket[]
  messages                    TicketMessage[]
  managedServiceSubscriptions ManagedServiceSubscription[]

  @@index([email])
}

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)
  currency    String      @default("EUR")
  lineItems   Json // [{sku, description, qty, unitPrice}]
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  documents Document[]

  @@index([customerId])
  @@index([reference])
}

model Quote {
  id          String      @id @default(cuid())
  reference   String      @unique
  status      QuoteStatus @default(DRAFT)
  totalAmount Decimal     @db.Decimal(12, 2)
  currency    String      @default("EUR")
  lineItems   Json
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Document {
  id          String   @id @default(cuid())
  name        String
  description String?
  storagePath String // path inside Supabase Storage bucket
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  reportId String?          @unique
  report   QuarterlyReport? @relation(fields: [reportId], references: [id])

  @@index([customerId])
  @@index([orderId])
}

model SupportTicket {
  id        String         @id @default(cuid())
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  messages TicketMessage[]

  @@index([customerId])
  @@index([status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ── Managed-Service-Quartalsberichte ────────────────────────
// productSlug referenziert bewusst das slug-Feld aus
// src/app/produkte/products-data.ts (z.B. "oceanprotect"), statt eine
// eigene Produkt-Taxonomie zu pflegen.
model ManagedServiceSubscription {
  id          String              @id @default(cuid())
  productSlug String
  packageId   SubscriptionPackage
  active      Boolean             @default(true)
  startDate   DateTime            @default(now())
  createdAt   DateTime            @default(now())

  // Vom Collector gemeldet (meta.deviceSerialNumber im Ingest-Payload) —
  // bei OceanProtect die Huawei-ESN, gleichzeitig die deviceId, mit der der
  // Collector sich am DeviceManager anmeldet. Geräteattribut, keine
  // Zeitreihen-Kennzahl, daher hier statt in ManagedServiceMetric.
  deviceSerialNumber String?

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  apiKeys    CollectorApiKey[]
  ingestions CollectorIngestion[]
  metrics    ManagedServiceMetric[]
  reports    QuarterlyReport[]

  @@index([customerId])
  @@index([productSlug])
}

model CollectorApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique
  label      String
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  subscriptionId String
  subscription   ManagedServiceSubscription @relation(fields: [subscriptionId], references: [id])

  ingestions CollectorIngestion[]

  @@index([subscriptionId])
}

model CollectorIngestion {
  id         String          @id @default(cuid())
  payload    Json
  source     IngestionSource @default(COLLECTOR)
  receivedAt DateTime        @default(now())

  subscriptionId String
  subscription   ManagedServiceSubscription @relation(fields: [subscriptionId], references: [id])

  // Null for MANUAL_UPLOAD ingestions (admin-authenticated upload of an
  // export file from an air-gapped/offline collector run — no API key
  // involved, since the site has no network path to the ingestion API).
  apiKeyId String?
  apiKey   CollectorApiKey? @relation(fields: [apiKeyId], references: [id])

  metrics ManagedServiceMetric[]

  @@index([subscriptionId])
}

model ManagedServiceMetric {
  id         String   @id @default(cuid())
  metricKey  String
  value      Float
  unit       String?
  recordedAt DateTime

  subscriptionId String
  subscription   ManagedServiceSubscription @relation(fields: [subscriptionId], references: [id])

  ingestionId String
  ingestion   CollectorIngestion @relation(fields: [ingestionId], references: [id])

  @@index([subscriptionId, metricKey, recordedAt])
}

model QuarterlyReport {
  id          String           @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  periodType  ReportPeriodType @default(QUARTER)
  status      ReportStatus     @default(DRAFT)
  summary     Json // berechnete Kennzahlen zum Erstellzeitpunkt (reproduzierbar)
  adminNotes  String?
  generatedAt DateTime         @default(now())
  publishedAt DateTime?

  subscriptionId String
  subscription   ManagedServiceSubscription @relation(fields: [subscriptionId], references: [id])

  document Document?

  @@index([subscriptionId])
  @@index([periodStart, periodEnd])
}
