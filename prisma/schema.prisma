generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Uncomment directUrl when using Supabase pgbouncer (transaction pooler) as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SubscriptionPackage {
  MONITOR
  OPERATE
  COMPLETE
}

enum ReportStatus {
  DRAFT
  PUBLISHED
}

enum ReportPeriodType {
  MONTH
  QUARTER
  HALF_YEAR
  YEAR
}

enum IngestionSource {
  COLLECTOR
  MANUAL_UPLOAD
}

enum FindingKind {
  ALARM
  COMPONENT_FAULT
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  company      String?
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders                      Order[]
  quotes                      Quote[]
  documents                   Document[]
  tickets                     SupportTicket[]
  messages                    TicketMessage[]
  managedServiceSubscriptions ManagedServiceSubscription[]

  @@index([email])
}

model Order {
  id          String      @id @default(cuid())
  reference   String      @unique
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)
  currency    String      @default("EUR")
  lineItems   Json // [{sku, description, qty, unitPrice}]
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  documents Document[]

  @@index([customerId])
  @@index([reference])
}

model Quote {
  id          String      @id @default(cuid())
  reference   String      @unique
  status      QuoteStatus @default(DRAFT)
  totalAmount Decimal     @db.Decimal(12, 2)
  currency    String      @default("EUR")
  lineItems   Json
  validUntil  DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Document {
  id          String   @id @default(cuid())
  name        String
  description String?
  storagePath String // path inside Supabase Storage bucket
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  reportId String?          @unique
  report   QuarterlyReport? @relation(fields: [reportId], references: [id])

  @@index([customerId])
  @@index([orderId])
}

model SupportTicket {
  id        String         @id @default(cuid())
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(MEDIUM)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  messages TicketMessage[]

  @@index([customerId])
  @@index([status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([ticketId])
}

// ── Managed-Service-Quartalsberichte ────────────────────────
// productSlug referenziert bewusst das slug-Feld aus
// src/app/produkte/products-data.ts (z.B. "oceanprotect"), statt eine
// eigene Produkt-Taxonomie zu pflegen.
model ManagedServiceSubscription {
  id          String              @id @default(cuid())
  productSlug String
  packageId   SubscriptionPackage
  active      Boolean             @default(true)
  startDate   DateTime            @default(now())
  createdAt   DateTime            @default(now())

  // Vom Collector gemeldet (meta im Ingest-Payload) — Geräteattribute, keine
  // Zeitreihen-Kennzahlen, daher hier statt in ManagedServiceMetric.
  deviceSerialNumber    String?
  deviceModel           String?
  deviceSoftwareVersion String?
  // Bei OceanProtect eine zweite, unabhängige Versionsnummer: die
  // Backup-Software (DataBackup) läuft als eigener Dienst mit eigenem
  // Versionsstand, getrennt von der Storage-Firmware in deviceSoftwareVersion.
  dataBackupVersion     String?
  // Version+Build des Collector-Skripts selbst, das zuletzt Daten für diese
  // Subscription gemeldet hat (siehe collector/version.js) — für den
  // Admin-Bereich, um veraltete Collector-Stände zu erkennen (siehe
  // getCollectorBaseline in src/lib/settings.ts).
  collectorVersion      String?

  // Aufschlüsselung der bei DataBackup bekannten Ressourcen nach Typ
  // (Dateisystem, Datenbank, VM, …) inkl. geschützt/ungeschützt — vom
  // letzten Ingest überschrieben, keine Historie (im Gegensatz zu Alarmen/
  // Component Faults ist das eine reine Momentaufnahme ohne "aktiv/gelöst"-
  // Konzept, daher weiterhin als einfaches JSON statt eigener Tabelle).
  resourceBreakdown Json?

  // Die am häufigsten fehlgeschlagenen Jobs, getrennt nach SLA-Richtlinie
  // und nach Ressource — vom letzten Ingest überschrieben, keine Historie.
  topJobFailures Json?

  // JEDE geprüfte Hardware-/Verbindungskomponente (normal UND fehlerhaft) —
  // vom letzten Ingest überschrieben, keine Historie (im Gegensatz zu
  // componentFaults/DeviceFinding kein aktiv/gelöst-Konzept). Grundlage für
  // den abschließenden "erfolgreich geprüft"-Referenzabschnitt im Bericht.
  componentChecks Json?

  // Freitext, den ein Admin manuell pflegt, um eine Beziehung zu einem
  // anderen System zu dokumentieren (z. B. "Snapshots werden von
  // OceanProtect X8000 repliziert") — im Bericht als Hinweiszeile gezeigt.
  replicationNote String?

  // Voreingestellter Berichtszyklus für diese Subscription (z. B. Quartal
  // bei OceanProtect, Monat bei OceanStor desselben Kunden) — steuert nur
  // die Vorauswahl im Admin-Bereich, keine automatische Erstellung.
  defaultPeriodType ReportPeriodType @default(QUARTER)

  // Wie lange Rohdaten (ManagedServiceMetric, CollectorIngestion, bereits
  // gelöste DeviceFinding-Einträge) für diese Subscription aufbewahrt
  // werden, bevor der Cleanup-Cron sie löscht. null = unbegrenzt (Default,
  // kein Datenverlust ohne bewusste Konfiguration). Aktive/ungelöste
  // Findings werden unabhängig vom Alter nie automatisch gelöscht.
  metricsRetentionDays Int?

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  apiKeys    CollectorApiKey[]
  ingestions CollectorIngestion[]
  metrics    ManagedServiceMetric[]
  reports    QuarterlyReport[]
  findings   DeviceFinding[]

  @@index([customerId])
  @@index([productSlug])
}

model CollectorApiKey {
  id         String    @id @default(cuid())
  keyHash    String    @unique
  label      String
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  subscriptionId String
  subscription   ManagedServiceSubscription @relation(fields: [subscriptionId], references: [id])

  ingestions CollectorIngestion[]

  @@index([subscriptionId])
}

model CollectorIngestion {
  id         String          @id @default(cuid())
  payload    Json
  source     IngestionSource @default(COLLECTOR)
  receivedAt DateTime        @default(now())

  // Nur bei MANUAL_UPLOAD gesetzt — der ursprüngliche Dateiname der
  // hochgeladenen Collector-Export-Datei, für die Ingestion-Übersicht im
  // Admin-Bereich ("welche Datei wurde wann hochgeladen").
  fileName String?

  subscriptionId String
  subscription   ManagedServiceSubscription @relation(fields: [subscriptionId], references: [id])

  // Null for MANUAL_UPLOAD ingestions (admin-authenticated upload of an
  // export file from an air-gapped/offline collector run — no API key
  // involved, since the site has no network path to the ingestion API).
  apiKeyId String?
  apiKey   CollectorApiKey? @relation(fields: [apiKeyId], references: [id])

  metrics ManagedServiceMetric[]

  @@index([subscriptionId])
}

model ManagedServiceMetric {
  id         String   @id @default(cuid())
  metricKey  String
  value      Float
  unit       String?
  recordedAt DateTime

  subscriptionId String
  subscription   ManagedServiceSubscription @relation(fields: [subscriptionId], references: [id])

  ingestionId String
  ingestion   CollectorIngestion @relation(fields: [ingestionId], references: [id])

  @@index([subscriptionId, metricKey, recordedAt])
}

// Alarme (vom Storage-Gerät gemeldet) und Component Faults (vom Collector
// aus Health-Checks abgeleitet, z. B. "Controller 0B fehlerhaft") mit
// Verlauf: bei jedem Ingest wird abgeglichen, welche zuvor offenen Einträge
// nicht mehr gemeldet werden (→ resolvedAt gesetzt) und welche neu sind.
// identityKey ist der stabile Schlüssel, über den ein Eintrag über mehrere
// Ingests hinweg wiedererkannt wird (z. B. "Controller:0B" oder die
// Alarm-Sequenznummer des Geräts).
model DeviceFinding {
  id          String      @id @default(cuid())
  kind        FindingKind
  identityKey String
  category    String
  title       String
  description String
  suggestion  String?
  firstSeenAt DateTime    @default(now())
  lastSeenAt  DateTime    @default(now())
  resolvedAt  DateTime?

  subscriptionId String
  subscription   ManagedServiceSubscription @relation(fields: [subscriptionId], references: [id])

  @@unique([subscriptionId, kind, identityKey])
  @@index([subscriptionId, kind, resolvedAt])
}

model QuarterlyReport {
  id          String           @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  periodType  ReportPeriodType @default(QUARTER)
  status      ReportStatus     @default(DRAFT)
  summary     Json // berechnete Kennzahlen zum Erstellzeitpunkt (reproduzierbar)
  adminNotes  String?
  generatedAt DateTime         @default(now())
  publishedAt DateTime?

  subscriptionId String
  subscription   ManagedServiceSubscription @relation(fields: [subscriptionId], references: [id])

  // Für kombinierte Berichte (mehrere Produkte desselben Kunden im selben
  // Zyklus in einem PDF): weitere Subscription-IDs neben der primären
  // subscriptionId oben. Leer für einen Einzelprodukt-Bericht.
  additionalSubscriptionIds String[] @default([])

  document Document?

  @@index([subscriptionId])
  @@index([periodStart, periodEnd])
}
